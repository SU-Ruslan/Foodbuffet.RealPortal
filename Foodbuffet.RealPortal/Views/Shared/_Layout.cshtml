    <!-- Различающиеся элементы -->
    <title>@ViewData["Title"]</title>
    <meta content="@ViewData["OGTitle"]" property="og:title" />
    <meta content="@ViewData["TwitterTitle"]" property="twitter:title" />
    <meta content="@ViewData["OGImage"]" property="og:image" />
    <meta content="@ViewData["TwitterImage"]" property="twitter:image" />
    <link href="@ViewData["CSSPath"]" rel="stylesheet" type="text/css" />
    <link href="@ViewData["FaviconPath"]" rel="shortcut icon" type="image/x-icon" />
    <link href="@ViewData["AppIconPath"]" rel="apple-touch-icon" />

    <!-- Общие элементы -->
    <meta content="FoodBuffet X is a premium Restaurant Webflow Template crafted for restaurants aiming to create a stylish, responsive website to attract food lovers and increase bookings."
          name="description" />
    <meta content="FoodBuffet X is a premium Restaurant Webflow Template crafted for restaurants aiming to create a stylish, responsive website to attract food lovers and increase bookings."
          property="og:description" />
    <meta content="FoodBuffet X is a premium Restaurant Webflow Template crafted for restaurants aiming to create a stylish, responsive website to attract food lovers and increase bookings."
          property="twitter:description" />
    <meta property="og:type" content="website" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="Webflow" name="generator" />

    <script type="text/javascript">
        !function (o, c) {
            var n = c.documentElement, t = " w-mod-";
            n.className += t + "js",
            ("ontouchstart" in o || o.DocumentTouch && c instanceof DocumentTouch) &&
            (n.className += t + "touch")
        }(window, document);
    </script>

    <style>
        .w-webflow-badge {
            display: none !important;
        }
    </style>
    <style>
        .w-form-done, .w-form-fail {
            display: none !important;
        }
    </style>


    <script type="text/javascript">
        window.__WEBFLOW_CURRENCY_SETTINGS = {
            "currencyCode": "USD",
            "symbol": "$",
            "decimal": ".",
            "fractionDigits": 2,
            "group": ",",
            "template": "{{wf {\"path\":\"symbol\",\"type\":\"PlainText\"} }} {{wf {\"path\":\"amount\",\"type\":\"CommercePrice\"} }} {{wf {\"path\":\"currencyCode\",\"type\":\"PlainText\"} }}",
            "hideDecimalForWholeNumbers": false
        };
    </script>

